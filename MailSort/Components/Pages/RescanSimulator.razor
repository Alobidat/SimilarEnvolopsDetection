@page "/rescan-simulator"
@using MailSort.Api
@inject ApiClient Api

<PageTitle>Rescan Simulator</PageTitle>

<h2>Rescan Simulator</h2>

<p class="muted">
    Generates synthetic re-scan images from a folder of originals by applying
    realistic scanner perturbations: tilt, brightness shift, and Gaussian noise.
    Each original <code>*_PieceImage.tiff</code> produces one augmented
    <code>*_PieceImage - Rescan.tiff</code> in the output folder.
    Use the output folder as the <b>Second-scan folder</b> in the
    <a href="/duplicate-scan-test">Duplicate-Scan Test</a>.
</p>

<div class="form">
    <label>
        Source folder
        <input @bind="_sourceFolder" placeholder="e.g. C:\work\ELC\AI Detection\samples" />
    </label>
    <label>
        Output folder
        <input @bind="_outputFolder" placeholder="e.g. C:\work\ELC\AI Detection\samples-sim" />
    </label>

    <div class="sim-params">
        <label class="range-label">
            Max tilt &nbsp;<strong>±@_maxTiltDeg.ToString("F1")°</strong>
            <input type="range" min="0" max="10" step="0.5" @bind="_maxTiltDeg" />
        </label>
        <label class="range-label">
            Brightness variation &nbsp;<strong>±@((_brightnessDelta * 100).ToString("F0"))%</strong>
            <input type="range" min="0" max="0.40" step="0.01" @bind="_brightnessDelta" />
        </label>
        <label class="range-label">
            Noise (σ px) &nbsp;<strong>@_noiseSigma.ToString("F0")</strong>
            <input type="range" min="0" max="40" step="1" @bind="_noiseSigma" />
        </label>
        <label class="range-label">
            Seed &nbsp;<strong>@(_seed < 0 ? "random" : _seed.ToString())</strong>
            <input type="range" min="-1" max="999" step="1" @bind="_seed" />
        </label>
    </div>

    <div class="form inline">
        <button disabled="@(_running || string.IsNullOrWhiteSpace(_sourceFolder) || string.IsNullOrWhiteSpace(_outputFolder))"
                @onclick="Run">
            @(_running ? "Generating…" : "Generate")
        </button>
        <button class="secondary" disabled="@_running" @onclick="ResetDefaults">Reset defaults</button>
    </div>
</div>

@if (!string.IsNullOrEmpty(_error))
{
    <div class="error">@_error</div>
}

@if (_result is not null)
{
    <div class="stats">
        <div class="stat ok">
            <div class="stat-num">@_result.RescansGenerated</div>
            <div class="stat-label">re-scans generated</div>
        </div>
    </div>

    <p class="muted">
        Output: <code>@_result.OutputFolder</code> &mdash;
        use as the <b>Second-scan folder</b> in <a href="/duplicate-scan-test">Duplicate-Scan Test</a>.
    </p>

    <table class="sim-table">
        <thead>
            <tr>
                <th>Original</th>
                <th>Rescan file</th>
                <th>Tilt</th>
                <th>Brightness</th>
                <th>Noise σ</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var e in _result.Entries)
            {
                <tr>
                    <td class="mono">@e.OriginalFile</td>
                    <td class="mono">@e.RescanFile</td>
                    <td class="num">@e.TiltApplied.ToString("F2")°</td>
                    <td class="num">@((e.BrightnessFactorApplied * 100 - 100).ToString("+0.0;-0.0;0"))%</td>
                    <td class="num">@e.NoiseSigmaApplied.ToString("F0")</td>
                </tr>
            }
        </tbody>
    </table>
}

@code {
    private string _sourceFolder = string.Empty;
    private string _outputFolder = string.Empty;
    private double _maxTiltDeg   = 3.0;
    private double _brightnessDelta = 0.15;
    private double _noiseSigma   = 8.0;
    private int    _seed         = 42;
    private bool   _running;
    private string? _error;
    private RescanSimResult? _result;

    protected override void OnInitialized()
    {
        _sourceFolder = DuplicateScanEndpoints.DefaultSamplesFolder();
        _outputFolder = Path.Combine(
            Path.GetDirectoryName(_sourceFolder) ?? _sourceFolder,
            Path.GetFileName(_sourceFolder) + "-sim");
    }

    private void ResetDefaults()
    {
        _maxTiltDeg     = 3.0;
        _brightnessDelta = 0.15;
        _noiseSigma     = 8.0;
        _seed           = 42;
    }

    private async Task Run()
    {
        _running = true;
        _error   = null;
        _result  = null;
        try
        {
            var req = new RescanSimRequest(
                SourceFolder:    _sourceFolder,
                OutputFolder:    _outputFolder,
                MaxTiltDeg:      _maxTiltDeg,
                BrightnessDelta: _brightnessDelta,
                NoiseSigma:      _noiseSigma,
                Seed:            _seed);

            var url = Api.Api("/api/rescan-sim/generate");
            var resp = await Api.Http.PostAsJsonAsync(url, req);
            resp.EnsureSuccessStatusCode();
            _result = await resp.Content.ReadFromJsonAsync<RescanSimResult>(
                new System.Text.Json.JsonSerializerOptions(System.Text.Json.JsonSerializerDefaults.Web));
        }
        catch (Exception ex)
        {
            _error = ex.Message;
        }
        finally
        {
            _running = false;
        }
    }
}
