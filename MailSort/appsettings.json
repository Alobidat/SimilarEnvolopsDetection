{
  "ConnectionStrings": {
    "MailSort": "Data Source=data/mailsort.db"
  },
  "Storage": {
    "ImageRoot": "data/images",
    "TrayMapCsv": "tray-map.csv"
  },
  "Match": {
    "WindowHours": 24,
    "MatchEngine": {
      "MaxAddressPHashDistance": 64,
      "MaxBarcodePHashDistance": 18,
      "TopK": 7,
      "AddressRoi": {
        "X": 0.61, "Y": 0.21, "Width": 0.36, "Height": 0.10
      },
      "BarcodeRoi": {
        "X": 0.61, "Y": 0.31, "Width": 0.36, "Height": 0.16
      }
    }
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*"
}
